{
  "expo": {
    "name": "SharedKitchen",
    "slug": "sharedkitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sharedkitchen",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sharedkitchen.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sharedkitchen.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.sharedkitchen.app",
          "enableApplePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#334537"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SharedKitchen uses your camera to scan food and identify dishes."
        }
      ],
      "expo-image-manipulator"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64a49c7a-42df-4af8-8f18-43b1d7685e40"
      }
    }
  }
}
